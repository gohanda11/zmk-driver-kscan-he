DT_COMPAT_ZMK_KSCAN_ADC_MUX := zmk,kscan-adc-mux

config ZMK_KSCAN_ADC_MUX
    bool "Hall Effect ADC MUX kscan driver"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_KSCAN_ADC_MUX))
    select ADC
    select GPIO
    select SETTINGS
    select PM_DEVICE if ZMK_SLEEP
    help
      Enable the Hall Effect keyboard scanner driver using
      SN74LV4051A analog multiplexers and SAADC.
      Reads GH39FKSW Hall Effect sensor values and converts
      to ZMK key press/release events.

config ZMK_KSCAN_HE_CONFIGURABLE_THRESHOLDS
    bool "Runtime-configurable per-key thresholds for HE kscan"
    default y
    depends on ZMK_KSCAN_ADC_MUX
    help
      Enable per-key threshold arrays and the zmk_kscan_he_api public API.
      Thresholds can be changed at runtime and persisted to NVS via
      Zephyr settings subsystem.

config ZMK_KSCAN_HE_MODE3_DEBUG
    bool "Mode3 suspend debug: test Mode3 for 10s before System OFF"
    default n
    depends on ZMK_KSCAN_ADC_MUX
    help
      When enabled, the suspend handler waits 10s in Mode1, then enters
      Mode3 for 10s logging AWAKE level every second, returns to Mode1,
      then proceeds with the normal sleep sequence (SENSE arm + System OFF).
      Use only for debugging SC4823 Mode3 wakeup behavior.
